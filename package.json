{
  "name": "@florent-uzio/xrpl-mcp",
  "version": "1.3.1",
  "description": "MCP server exposing XRP Ledger tools and token issuance workflows",
  "license": "ISC",
  "author": "Florent Uzio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florent-uzio/xrpl-mcp.git"
  },
  "type": "module",
  "bin": {
    "xrpl-mcp": "dist/xrpl-mcp.js"
  },
  "files": [
    "dist/xrpl-mcp.js",
    "dist/mpt_crypto.wasm",
    "dist/THIRD_PARTY_LICENSES.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "xrpl",
    "xrp-ledger",
    "mcp",
    "model-context-protocol"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "mcp": "tsx src/stdio.ts",
    "build": "node scripts/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/release-guard.mjs",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@mastra/core": "^1.78.0",
    "@mastra/mcp": "^2.5.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "xrpl": "5.4.0-beta.0",
    "zod": "^4.6.7"
  }
}
